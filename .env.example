# Server port (optional, defaults to 3000 and picks the next free port if busy)
PORT=3000

# Optional server-side LLM defaults. If left empty, callers must supply their
# own OpenRouter API key (sk-or-...) and model from the app UI.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
